{
  "name": "10 — Follow-Up Scheduler",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "followup/schedule",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "id": "webhook-followup",
      "name": "Webhook Follow-Up Scheduler"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://gxvketvhwjftkfuerfai.supabase.co/rest/v1/followups",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "sb_publishable_9NuSOztl4jnE0ZTqPJk-sw_toNrpwz0" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"lead_id\": \"{{ $json.body.lead_id }}\",\n  \"priority\": \"{{ $json.body.priority || 'HIGH' }}\",\n  \"reason\": \"{{ $json.body.reason || 'Requested callback during AI call' }}\",\n  \"website_need\": \"{{ $json.body.website_need || 'BASIC_BUSINESS_WEBSITE' }}\",\n  \"summary\": \"{{ $json.body.summary || 'Follow up with business owner' }}\"\n}"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [500, 300],
      "id": "insert-followup-db",
      "name": "Insert Follow-Up Task in DB"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"status\": \"FOLLOWUP_SCHEDULED\",\n  \"lead_id\": \"{{ $node['Webhook Follow-Up Scheduler'].json.body.lead_id }}\"\n}"
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [750, 300],
      "id": "respond-followup-created",
      "name": "Respond Scheduled"
    }
  ],
  "connections": {
    "Webhook Follow-Up Scheduler": {
      "main": [[{ "node": "Insert Follow-Up Task in DB", "type": "main", "index": 0 }]]
    },
    "Insert Follow-Up Task in DB": {
      "main": [[{ "node": "Respond Scheduled", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
